<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">

  <div class="d-flex justify-content-between align-items-center mb-4">

  <span class="fw-bold">Usuario logueado</span>
<a class="btn btn-outline-danger btn-sm" href="/logout">Cerrar sesión</a>
</div>

  <a class="btn btn-success mb-3" href="/products/new">
    Nuevo producto
  </a>

<h1 class="mb-4">Productos</h1>

<form method="GET" action="/products" class="row g-3 mb-4">
  <div class="col-md-3">
    <input class="form-control"
    type="text" 
    name="name" 
    placeholder="Buscar por nombre" 
    value="<%= name || "" %>">
    </div>
    <div class="col-md-2">
    <input class="form-control"
    type="number" 
    name="min" 
    placeholder="Precio mínimo" 
    value="<%= min || "" %>">
    </div>
    <div class="col-md-2">
    <input class="form-control"
    type="number" 
    name="max" 
    placeholder="Precio máximo" 
    value="<%= max || "" %>">
</div>
    <div class="col-md-3">
    <select class="form-select" name="tag">
        <option value="">Todos los tags</option>
        <option value="work" <%= tag === "work" ? "selected" : "" %>>work</option>
        <option value="lifestyle" <%= tag === "lifestyle" ? "selected" : "" %>>lifestyle</option>
        <option value="motor" <%= tag === "motor" ? "selected" : "" %>>motor</option>
        <option value="mobile" <%= tag === "mobile" ? "selected" : "" %>>mobile</option>
    </select>
    </div>
    <div class="col-md-2">
    <button class="btn btn-primary w-100" type="submit">Buscar</button>
    </div>
</form>

  <!-- recorremos cada producto del array -->
  <div class="row">

    <% for (let product of products) { %>

      <div class="col-md-4 mb-3">
        <div class="card h-100">
          <div class="card-body">

            <!-- mostramos nombre y precio del producto -->
            <h5 class="card-title">Producto: <%= product.name %></h5>
            <p class="card-text">Precio: <%= product.price %></p>

            <p class="mb-1">Tags:</p>

            <!-- recorremos tag del producto -->
            <% for (let tag of product.tags) { %>

              <!-- mostramos tag -->
              <span class="badge bg-secondary me-1"><%= tag %></span>

            <% } %>

            <p class="mt-3">Propietario: <%= product.owner.name %></p>

            <div class="d-flex gap-2 align-items-center">
              
              <a class="btn btn-warning btn-sm" href="/products/<%= product._id %>/edit">
                Editar producto
              </a>

              <form class="d-inline m-0 p-0" method="POST" action="/products/<%= product._id %>/delete">
                <button class="btn btn-danger btn-sm" type="submit">
                  Borrar artículo
                </button>
              </form>

            </div>

          </div>
        </div>
      </div>

    <% } %>

  </div>

<div  class="d-flex justify-content-between mt-4">
    <% const currentSkip = Number(skip) || 0; %>
    <% const currentLimit = Number(limit) || 1; %>

    <% if (currentSkip > 0) { %>
<a class="btn btn-outline-secondary" href="/products?skip=<%= Math.max(currentSkip - currentLimit, 0) %>&limit=<%= currentLimit %>&name=<%= name || '' %>&tag=<%= tag || '' %>&min=<%= min || '' %>&max=<%= max || '' %>">
  Anterior
</a>

<% } else { %>
  <span></span>
  <% } %>

<a class="btn btn-outline-secondary" href="/products?skip=<%= currentSkip + currentLimit %>&limit=<%= currentLimit %>&name=<%= name || '' %>&tag=<%= tag || '' %>&min=<%= min || '' %>&max=<%= max || '' %>">
  Siguiente
</a>

</div>
</div>