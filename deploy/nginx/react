server {
    listen 80 default_server;

    server_name 54.83.243.187;

    root /var/www/apps/practica-fundamentos-react/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_redirect off;
    }

    location /auth/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_redirect off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
